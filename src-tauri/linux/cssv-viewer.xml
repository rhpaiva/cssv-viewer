<?xml version="1.0" encoding="UTF-8"?>
<!-- Tells Linux desktops that *.cssv files are CSSV tables, so they open in the
     viewer. CSSV has no registered media type (SPEC 3.3); this name is local
     to the desktop. A CSSV file is plain text, so text editors still offer it. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-cssv">
    <comment>CSSV table</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.cssv"/>
  </mime-type>
</mime-info>

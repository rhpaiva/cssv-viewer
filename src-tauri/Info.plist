<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the macOS app's Info.plist. A key here replaces Tauri's, so
     this is the document type Tauri makes of bundle.fileAssociations in
     tauri.conf.json, keep the two alike, with the icon of .cssv files, which
     bundle.macOS.files puts in Contents/Resources. -->
<plist version="1.0">
<dict>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>cssv</string>
      </array>
      <key>CFBundleTypeName</key>
      <string>CSSV table</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Default</string>
      <key>CFBundleTypeIconFile</key>
      <string>cssv-file</string>
    </dict>
  </array>
</dict>
</plist>
